# Copy to .env values into your environment (or use: export $(cat .env | xargs))
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collation
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
COMMAND_PASSCODE=           # optional; if empty a random one is generated and printed ONCE at first boot
DATA_DIR=./data             # video clips are stored here (on the Command Centre PC)
# HTTPS (required for phone camera/GPS/mic). Leave empty to run plain HTTP behind a reverse proxy / on localhost.
HTTPS_KEY=./certs/key.pem
HTTPS_CERT=./certs/cert.pem
# WebRTC: add a TURN server for observers on mobile networks
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Parties (edit to the full 2027 registered list)
PARTIES=APC,PDP,NNPP,ADC,NDC,LP,SDP,APGA,YPP,AA
# Offline speech-to-text fallback: URL of a local STT service that accepts audio POST and returns {"text":"..."}
STT_URL=
# LiveKit (SFU with simulcast, low-bandwidth video + restream). Leave empty to use direct WebRTC.
LIVEKIT_URL=wss://your-domain/lk
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
APP_NAME=My Collation Center
