# start.sh creates .env for you. Manual template:
DOMAIN=collation.example.com      # or the server LAN IP
PUBLIC_IP=203.0.113.10
CADDY_TLS=                        # leave empty for a public domain (Let's Encrypt); "tls internal" for a LAN IP
DB_PASSWORD=change-me
JWT_SECRET=change-me-long-random
TURN_SECRET=change-me-long-random
COMMAND_PASSCODE=change-me
PARTIES=APC,PDP,NNPP,ADC,NDC,LP,SDP,APGA,YPP,AA
STT_URL=
LK_KEY=APIchangeme
LK_SECRET=change-me-40-chars
COMPOSE_PROFILES=restream     # add ',turn' on Linux for the extra coturn relay
APP_NAME=My Collation Center  # can also be changed in Command Center > App Settings
