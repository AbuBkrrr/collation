{$DOMAIN} {
	{$CADDY_TLS}
	# Auto-HTTPS (Let's Encrypt) is on by default. The app sets the security headers
	# (CSP, HSTS, X-Frame-Options, …); here we just stop advertising the server software.
	header {
		-Server
		-X-Powered-By
	}
	# LiveKit signalling (wss) and media negotiation
	handle_path /lk/* {
		reverse_proxy livekit:7880
	}
	# app: REST API, the /ws live-updates WebSocket, and the three web apps
	reverse_proxy app:3000
	encode gzip
	request_body {
		max_size 320MB
	}
}
